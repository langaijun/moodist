---
import Layout from '@/layouts/layout.astro';

import Hero from '@/components/hero.astro';

import { App } from '@/components/app';
import CategoryIcons from '@/components/categories/category-icons/category-icons';
---

<Layout title="Moodist: Ambient Sounds for Focus and Calm">
  <div class="header">
    <div class="title-group">
      <h1 class="main-title">
        Ambient Sounds<span class="line">For Focus and Calm</span>
      </h1>
    </div>
  </div>
  <Hero />
  <CategoryIcons client:load />
  <App client:load />
</Layout>

<style>
  .header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1200px;
    padding: 20px 24px;
    margin: 0 auto;
  }

  .title-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    text-align: center;
  }

  .main-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-lg);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground);

    & .line {
      display: block;
      margin-top: 2px;
      background: linear-gradient(
        var(--color-foreground-subtler),
        var(--color-foreground-subtle)
      );
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  @media (width <= 600px) {
    .header {
      padding: 16px 20px;
    }

    .title-group {
      gap: 8px;
    }

    .main-title {
      font-size: var(--font-md);
    }

  }
</style>
