---
import Layout from '@/layouts/layout.astro';

import Hero from '@/components/hero.astro';

import { App } from '@/components/app';
import CategoryIcons from '@/components/categories/category-icons/category-icons';
---

<Layout title="Moodist: Ambient Sounds for Focus and Calm">
  <div class="header">
    <div class="title-group">
      <h1 class="main-title">
        Ambient Sounds<span class="line">For Focus and Calm</span>
      </h1>
      <div aria-label="Sleep Astraea links" class="entry-links">
        <a
          class="entry-link"
          data-hush-route="assessment"
          data-utm-content="header_quiz"
          href="https://www.hushforsleep.com/en/assessment?utm_source=moodist&utm_medium=tool&utm_campaign=white_noise_entry&utm_content=header_quiz"
          rel="noreferrer"
          target="_blank"
        >
          3-minute Sleep Blocker Quiz
        </a>
      </div>
    </div>
    <a
      aria-label="Support with a donation!"
      class="coffee-button"
      href="https://ko-fi.com/langaijun"
      rel="noreferrer"
      target="_blank"
    >
      <svg
        fill="currentColor"
        height="24"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M18.5 3H6c-1.1 0-2 .9-2 2v5.71c0 3.83 2.95 7.18 6.78 7.29 3.96.12 7.22-3.06 7.22-7v-1h.5c1.93 0 3.5-1.57 3.5-3.5S20.43 3 18.5 3zM16 5v3H8V5h8zm2.5 3H18V5h.5c.83 0 1.5.67 1.5 1.5S19.33 8 18.5 8zM4 19h16v2H4v-2z"
        ></path>
      </svg>
    </a>
  </div>
  <Hero />
  <CategoryIcons client:load />
  <App client:load />
</Layout>

<script>
  const links = document.querySelectorAll('[data-hush-route]');
  const lang = navigator.language.toLowerCase();
  const locale = lang.startsWith('zh') ? 'zh' : 'en';

  links.forEach(link => {
    const route = link.getAttribute('data-hush-route');
    const utmContent = link.getAttribute('data-utm-content');
    if (!route || !utmContent) return;

    const url = new URL(`https://www.hushforsleep.com/${locale}/${route}`);
    url.searchParams.set('utm_source', 'moodist');
    url.searchParams.set('utm_medium', 'tool');
    url.searchParams.set('utm_campaign', 'white_noise_entry');
    url.searchParams.set('utm_content', utmContent);
    link.setAttribute('href', url.toString());
  });
</script>

<style>
  .header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1200px;
    padding: 20px 24px;
    margin: 0 auto;
  }

  .title-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    text-align: center;
  }

  .main-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-lg);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground);

    & .line {
      display: block;
      margin-top: 2px;
      background: linear-gradient(
        var(--color-foreground-subtler),
        var(--color-foreground-subtle)
      );
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  .coffee-button {
    position: absolute;
    top: 20px;
    right: 24px;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: #8b4513;
    text-decoration: none;
    cursor: pointer;
    background: linear-gradient(
      var(--color-neutral-100),
      var(--color-neutral-200)
    );
    border: 1px solid var(--color-neutral-300);
    border-radius: 50%;
    transition: 0.2s;
  }

  .coffee-button:hover {
    color: #6a3510;
    background: linear-gradient(
      var(--color-neutral-200),
      var(--color-neutral-300)
    );
    transform: scale(1.1);
  }

  .coffee-button:active {
    transform: scale(0.95);
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .entry-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 0 10px;
    font-size: 12px;
    color: var(--color-foreground);
    text-decoration: none;
    background: var(--color-neutral-100);
    border: 1px solid var(--color-neutral-300);
    border-radius: 999px;
    transition: 0.2s;
  }

  .entry-link:hover {
    background: var(--color-neutral-200);
    border-color: var(--color-neutral-400);
  }

  @media (width <= 600px) {
    .header {
      padding: 16px 20px;
    }

    .title-group {
      gap: 8px;
    }

    .main-title {
      font-size: var(--font-md);
    }

    .coffee-button {
      top: 16px;
      right: 20px;
      width: 40px;
      height: 40px;
    }
  }
</style>
